  "info": {
    "description": "Read-only dashboard HTTP API. Parameters and data types are projected from Loom's ESS model. A2A runs on each individual agent listener.",
    "summary": "The dashboard observation API on one server.",
    "title": "Loom server dashboard",
    "version": "v1",

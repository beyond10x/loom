          }
        },
        "security": [],
        "summary": "Read this OpenAPI document"
      }
    },
    "/api/snapshot": {
      "get": {
        "operationId": "readDashboardSnapshot",
        "parameters": [
          {
            "description": "The input field `agent`, carried in the query string: the route is encoded `query` and has no request body.",
            "in": "query",
            "name": "agent",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The input field `from`, carried in the query string: the route is encoded `query` and has no request body.",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "The input field `to`, carried in the query string: the route is encoded `query` and has no request body.",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "The quoted ETag of a previous response for this viewer and filter.",
            "in": "header",
            "name": "If-None-Match",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/loom.observation.ReadSnapshot.observed.Response"
                }
              }
            },
            "description": "Outcome `observed`, answered 200 as the `ess-http/1` binding declares, with the command's response field `snapshot`, bare: its value alone, with no object around it.",
            "headers": {
              "ETag": {
                "description": "Opaque, double-quoted SHA-256 validator.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "x-ess-outcomes": [
              "observed"
            ]
          },
          "304": {
            "description": "The viewer already has this representation. The response has no body."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/loom.observation.ReadSnapshot.invalid.Response"
                }
              }
            },
            "description": "Outcome `invalid`, answered 400 as the `ess-http/1` binding declares, with an object whose `error` is `invalid_request`, beside the error's own fields under their wire names.",
            "x-ess-outcomes": [
              "invalid"
            ]
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/loom.observation.ReadSnapshot.denied.Response"
                }
              }
            },
            "description": "Outcome `denied`, answered 401 as the `ess-http/1` binding declares, with an object whose `error` is `unauthorized`, beside the error's own fields under their wire names.",
            "headers": {
              "WWW-Authenticate": {
                "description": "One `Bearer` challenge (RFC 9110 §11.6.1).",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            },
            "x-ess-outcomes": [
              "denied"
            ]
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/loom.observation.ReadSnapshot.forbidden.Response"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "actor": {
                          "description": "The qualified name of the actor the request was authenticated as, or null where it was authenticated as none.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "refused": {
                          "description": "The standard refusal for an actor no grant admits.",
                          "enum": [
                            "not granted"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "refused",
                        "actor"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Outcome `forbidden`, answered 403 as the `ess-http/1` binding declares, with an object whose `error` is `forbidden`, beside the error's own fields under their wire names. No declared outcome: the standard refusal for an actor no grant admits: the request was authenticated as no actor, or as one `x-ess-may-invoke` does not list. It is checked before the command runs, so nothing was read, written or published, and the same request from a granted actor is decided by the command. Its body carries `refused` and `actor`, never the `outcome` and `error` a declared branch carries.",
            "x-ess-outcomes": [
              "forbidden"
            ]
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/loom.observation.ReadSnapshot.not-found.Response"
                }
              }
            },
            "description": "Outcome `not-found`, answered 404 as the `ess-http/1` binding declares, with an object whose `error` is `not_found`, beside the error's own fields under their wire names.",
            "x-ess-outcomes": [
              "not-found"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "snapshot_unavailable": "#/components/schemas/loom.observation.ReadSnapshot.unavailable-snapshot.Response",
                      "viewer_configuration_unavailable": "#/components/schemas/loom.observation.ReadSnapshot.unavailable-viewers.Response"
                    },
                    "propertyName": "error"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/loom.observation.ReadSnapshot.unavailable-viewers.Response"
                    },
                    {
                      "$ref": "#/components/schemas/loom.observation.ReadSnapshot.unavailable-snapshot.Response"
                    }
                  ]
                }
              }
            },
            "description": "Outcome `unavailable-viewers`, answered 503 as the `ess-http/1` binding declares, with an object whose `error` is `viewer_configuration_unavailable`, beside the error's own fields under their wire names. Outcome `unavailable-snapshot`, answered 503 as the `ess-http/1` binding declares, with an object whose `error` is `snapshot_unavailable`, beside the error's own fields under their wire names.",
            "x-ess-outcomes": [
              "unavailable-viewers",
              "unavailable-snapshot"
            ]
          }
        },
        "security": [
          {
            "viewerBearer": []
          }
        ],
        "summary": "Read the authenticated viewer's server snapshot",
        "tags": [
          "observation"
        ],
        "x-ess-route-source": "binding"
      }
    }
  },
  "tags": [
    {
      "description": "The read-only HTTP boundary for a viewer of one Loom server. The query filters authorized observations before constructing a response. An absent query result still produces a snapshot.",
      "name": "observation"
    }
  ]
